# Local development only. Copy to .env and keep the resulting file untracked.
APP_ENV=development
APP_NAME=Automotive Service CRM
APP_TIMEZONE=UTC
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_PATH=/api

# Use a dedicated local PostgreSQL database and replace CHANGE_ME locally.
DATABASE_URL=postgresql+psycopg://app_user:CHANGE_ME@127.0.0.1:5432/automotive_crm

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_HOSTS=localhost,127.0.0.1
TRUSTED_PROXY_CIDRS=
LOG_LEVEL=INFO
LOG_JSON=false

# Supply unique local values; do not commit generated secrets.
AUTH_SECRET_KEY=
AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_REFRESH_INACTIVITY_TTL_DAYS=30
AUTH_REFRESH_ABSOLUTE_TTL_DAYS=90
AUTH_REFRESH_COOKIE_NAME=crm_refresh_token
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAMESITE=lax

# Optional bootstrap account for a fresh local database.
BOOTSTRAP_ADMIN_LOGIN=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FULL_NAME=Demo Administrator

# Privacy and file-encryption material must be generated separately for local use.
CRM_DATA_ENCRYPTION_KEY=
CRM_DATA_ENCRYPTION_KEY_ID=local-v1
CRM_DATA_HASH_KEY=
CRM_FILE_ENCRYPTION_KEY=
CRM_FILE_ENCRYPTION_KEY_ID=local-v1
PUBLIC_SHARE_ENABLED=false

# Runtime data stays outside source control.
APP_RUNTIME_DIR=./.runtime
DOCUMENT_TEMPLATES_DIR=./documents_templates
DOCX_PDF_CONVERTER=auto
LIBREOFFICE_EXECUTABLE_PATH=
DOCX2PDF_PYTHON_EXECUTABLE=

# No vehicle dataset is distributed in this repository.
VEHICLE_CATALOG_PROVIDER=local_bundle
VEHICLE_CATALOG_BUNDLE_PATH=./demo/fixtures/vehicle-catalog-placeholder.json
VEHICLE_CATALOG_SOURCE_BASE_URL=https://example.invalid/api/vehicles
VEHICLE_CATALOG_MONTHLY_SYNC_ENABLED=false

# Generic protected inbound-lead endpoint limits.
EXTERNAL_LEAD_MAX_BODY_BYTES=65536
EXTERNAL_LEAD_RATE_LIMIT_WINDOW_SECONDS=60
EXTERNAL_LEAD_RATE_LIMIT_ATTEMPTS=30
